{"hash_algorithm":"sha256","ts":"2026-10-28T16:30:53.920Z","author":"codex-agent","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6.1-sol","agent_model_source":"probe","agent_instance":"3e9f2d7e484a891c56382bae","agent_provenance":{"model":{"value":"gpt-6.1-sol","source":"probe"},"effort":{"value":"high","source":"probe"},"role":null,"topic":null},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-10-28T16:30:53.920Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-10-28T16:30:53.920Z","author":"codex-agent","text":"Round 14 removes the referenced-project exemption entirely: references are now unsupported and tracked separately by pm-ts-starter-project-references. Native TypeScript 5.9.3 also returns resolvedFileName and isExternalLibraryImport but no packageId for the typesVersions subpath fixture in test/sdk-program-graph.test.ts. Retain isolation_refused there and unsupported_project_shape for unidentified relative local packages. The dependency corpus retains the original relative workspace fixture as a refusal and adds an installed-name workspace control. Future support must obtain a compiler-owned identity without synthesizing resolution or walking metadata ancestry."}]}],"before_hash":"36a5a8b16ae8ab17e2ae8bc748f6873a0c0b54b656296e0f5b2986eaa924aae0","after_hash":"71fc641dcb53f9306c475aefc29ce92e9a16c2686d96211b4c0194ae6b7196c0","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"effort":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"version":{"status":"unavailable","reason":"harness_unavailable","resolver":"ai_agent_version","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"6f0ec32250b9636070a3649d14bdc9e4f76dabd9393fbdfbaffb1d510db25cd4"}
{"hash_algorithm":"sha256","ts":"2026-10-28T16:30:57.411Z","author":"codex-agent","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6.1-sol","agent_model_source":"probe","agent_instance":"3e9f2d7e484a891c56382bae","agent_provenance":{"model":{"value":"gpt-6.1-sol","source":"probe"},"effort":{"value":"high","source":"probe"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"update","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-10-28T16:30:57.411Z"},{"op":"replace","path":"/metadata/description","value":"Follow-up to PR 154. Relative declarations across nested local package boundaries and some classic typesVersions subpaths lack a Program packageId. Preserve typed refusals until ownership is available from compiler resolution data, without synthetic imports, independent resolution or package metadata ancestry. Ordinary local declarations, unused metadata and compiler-identified installed dependencies remain supported. Project references are refused separately and tracked by pm-ts-starter-project-references."}],"before_hash":"71fc641dcb53f9306c475aefc29ce92e9a16c2686d96211b4c0194ae6b7196c0","after_hash":"0f9f193a6507dacd5ca731f00ce510991e959f554d9bd1994813f4394d6db345","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"effort":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"version":{"status":"unavailable","reason":"harness_unavailable","resolver":"ai_agent_version","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"075b68c1c0f8a8ec82ea0bc0f2ed3affa39db17ccb631f764c30d17214244ca2"}
