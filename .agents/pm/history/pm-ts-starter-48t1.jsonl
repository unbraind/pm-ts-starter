{"ts":"2026-08-22T17:57:54.807Z","author":"ox-alpha","author_source":"asserted","agent_harness":"pi","agent_model":"stealth/ox-alpha","agent_model_source":"environment","agent_instance":"a2bb8770e558f1ab8168ab5e","agent_provenance":{"model":{"value":"stealth/ox-alpha","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-ts-starter-48t1"},{"op":"add","path":"/metadata/title","value":"Drop inert pm manifest key and guard the closed manifest vocabulary"},{"op":"add","path":"/metadata/description","value":"pm-cli's extension-manifest vocabulary is a closed set of 18 keys; since pm-cli 2026.8.19 any other manifest.json key yields a manifest_unknown_key warning. This repo's manifest carried an inert top-level \"pm\": {\"compatibility\": \"v2\"} key that nothing in src/, scripts/, or test/ reads. It made downstream strict assertions (unbraind/pm-linear PRs #75/#76 expect finding codes exactly ['pm_min_version_unmet']) fail with an extra manifest_unknown_key code. This change deletes only that key, bumps the @unbrained/pm-cli devDependency pin from 2026.8.15 to 2026.8.22 (the older CLI cannot detect unknown keys), adds test/manifest-vocabulary.test.ts asserting zero unknown-key findings via checkExtensionManifestCompatibility against the exact pinned version, and updates smoke.test.ts to use 'list --all' instead of the deprecated 'list-all' alias whose stderr deprecation warning masked the read-buffer overrun runPm must surface."},{"op":"add","path":"/metadata/type","value":"Chore"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-08-22T17:57:54.807Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-22T17:57:54.807Z"},{"op":"add","path":"/metadata/author","value":"ox-alpha"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"8f72492ba375ac0a38e59ec9d4f5f2cd999ea72a6c523e6c03c57adeeda70c4b","item_hash_version":2,"message":""}
