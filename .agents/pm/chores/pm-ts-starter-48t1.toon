  package.json,project
  test/manifest-vocabulary.test.ts,project
  test/smoke.test.ts,project
tests[1]{command,path,scope}:
  PM_PATH=/tmp/pm-mv-pm-ts-starter PM_GLOBAL_PATH=/tmp/pm-mv-g-pm-ts-starter node --test test/manifest-vocabulary.test.ts,test/manifest-vocabulary.test.ts,project
close_reason: "Closed: dropped the inert top-level pm key from manifest.json (verified unread by grep over src/scripts/test), bumped @unbrained/pm-cli pin 2026.8.15 -> 2026.8.22, added test/manifest-vocabulary.test.ts guarding the closed manifest vocabulary (regression verified to fail with manifest_unknown_key when the key is re-added), fixed pre-existing smoke.test.ts red by using non-deprecated 'list --all'. Gates: npm test 149/149 pass; release:check exit 0; pinned pm health --strict-exit exit 0."
body: ""
